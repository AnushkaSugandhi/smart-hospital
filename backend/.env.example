# Environment Configuration
PORT=8000
ENVIRONMENT=development

# Optional PostgreSQL Connection string (defaults to SQLite if unset or unreachable)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/smart_hospital

# Production Frontend URL(s) for strict CORS (comma-separated)
# FRONTEND_ORIGIN=https://smart-hospital-frontend.vercel.app

# Signs login tokens. Set a long random value in production; if unset a random
# key is generated at startup and everyone is signed out on restart.
# SECRET_KEY=change-me-to-a-long-random-string
# TOKEN_TTL_HOURS=12

# ---- Ask Smart Hospital (AI assistant) ----
# Without a key the assistant still answers from live data (data-only mode).
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-opus-5-5
# LLM_EFFORT=low
# LLM_PROVIDER=offline          # force data-only answers

# Embeddings: Voyage AI if a key is set, otherwise a local hashing embedder.
# VOYAGE_API_KEY=...
# EMBEDDING_PROVIDER=local
# EMBEDDING_DIM=384
# POLICY_DOCS_DIR=../docs/policies
# CHAT_RATE_LIMIT_PER_MIN=20
